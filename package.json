{
  "name": "e2e-fontedeprecos",
  "version": "1.0.0",
  "private": true,
  "description": "Playwright E2E suite for Fonte de Preços cotação v2 (Item, Detalhes, satellites)",
  "scripts": {
    "test:e2e": "playwright test",
    "test:e2e:cotacao-v2": "playwright test playwright/e2e/cotacao-*.spec.ts",
    "test:e2e:cotacao-v2:stable": "playwright test playwright/e2e/cotacao-*.spec.ts --workers=1",
    "test:e2e:cotacao-v2:inject": "INJECT_TESTIDS=1 playwright test playwright/e2e/cotacao-*.spec.ts --workers=1",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:report": "playwright show-report",
    "test:e2e:install": "playwright install --with-deps chromium",
    "test:e2e:burn-in": "tsx playwright/scripts/burn-in-changed.ts"
  },
  "devDependencies": {
    "@faker-js/faker": "^9",
    "@playwright/test": "^1.54.1",
    "@seontechnologies/playwright-utils": "^4.4.0",
    "tsx": "4.19.3",
    "typescript": "~5.4",
    "zod": "^3"
  }
}
