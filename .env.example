# App under test (Nuxt frontend-fp must be reachable)
BASE_URL=http://127.0.0.1:3010
PLAYWRIGHT_PORT=3010

# Optional: auto-start Nuxt from a local frontend-fp checkout
# FRONTEND_DIR=/absolute/or/relative/path/to/frontend-fp

# Inject data-testid into the DOM when the app lacks them (stock frontend)
# INJECT_TESTIDS=1

# Auth (only if authSessionEnabled: true — most cotacao-v2 specs stub session)
# AUTH_BASE_URL=http://127.0.0.1:8103
# AUTH_HOST=
# TEST_USER_EMAIL=
# TEST_USER_PASSWORD=
# TEST_ENV=local

# Live API item test (skipped unless set)
# RUN_LIVE_ITEM_API=0
# TEST_ITEM_ID=
# API_URL=
